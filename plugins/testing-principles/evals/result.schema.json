{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Testing Principles evaluation result",
  "description": "One semantic evaluation observation. Store baselines separately from plugin-enabled observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "run_kind",
    "platform",
    "platform_version",
    "model",
    "timestamp",
    "observed_activation",
    "observed_workflows",
    "unexpected_activations",
    "evidence",
    "semantic_verdict",
    "findings",
    "unavailable_checks"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "run_kind": { "type": "string", "enum": ["plugin", "baseline"] },
    "platform": { "type": "string", "minLength": 1 },
    "platform_version": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "observed_activation": {
      "type": "string",
      "description": "Literal telemetry: yes when at least one workflow was decisively observed, no when decisive telemetry showed none, and unknown when telemetry was insufficient.",
      "enum": ["yes", "no", "unknown"]
    },
    "observed_workflows": {
      "type": "array",
      "description": "Exact identities of workflows decisively observed, independent of whether they were expected.",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "unexpected_activations": {
      "type": "array",
      "description": "Observed workflow identities absent from the case's expected_activation list.",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "semantic"],
      "properties": {
        "activation": {
          "type": "string",
          "description": "Explanation of the literal activation observation and recorded workflow identities.",
          "minLength": 1
        },
        "semantic": { "type": "string", "minLength": 1 },
        "execution": { "type": "string", "minLength": 1 }
      }
    },
    "semantic_verdict": {
      "type": "string",
      "enum": ["pass", "fail", "unverified"]
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "unavailable_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "observed_activation": { "const": "unknown" }
            }
          },
          {
            "properties": {
              "semantic_verdict": { "const": "unverified" }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "unavailable_checks": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observed_activation": { "const": "yes" }
        }
      },
      "then": {
        "properties": {
          "observed_workflows": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "observed_workflows": { "maxItems": 0 },
          "unexpected_activations": { "maxItems": 0 }
        }
      }
    }
  ]
}
